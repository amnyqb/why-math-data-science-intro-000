  },
  {
   "id": 23,
   "name": "Fraw",
   "kind": "Aux",
   "equation": "IF THEN ELSE(Auto > 0.5, kx*(CartX-ref) + kv*CartV + kth*PoleTh + kw*PoleW, 0) + Fuser",
   "units": "",
   "comment": "",
   "pos": [
    300.0,
    1580.0
   ],
   "non_negative": false,
   "from": null,
   "to": null,
   "from_pt": [
    0.0,
    1580.0
   ],
   "to_pt": [
    0.0,
    1580.0
   ]
  },
  {
   "id": 24,
   "name": "Force",
   "kind": "Aux",
   "equation": "MAX(0-Fmax, MIN(Fmax, Fraw))",
   "units": "",
   "comment": "",
   "pos": [
    300.0,
    1650.0
   ],
   "non_negative": false,
   "from": null,
   "to": null,
   "from_pt": [
    0.0,
    1650.0
   ],
   "to_pt": [
    0.0,
    1650.0
   ]
  },
  {
   "id": 25,
   "name": "Tmp",
   "kind": "Aux",
   "equation": "(Force - b*CartV + m*l*PoleW*PoleW*SIN(PoleTh))/(M+m)",
   "units": "",
   "comment": "",
   "pos": [
    300.0,
    1720.0
   ],
   "non_negative": false,
   "from": null,
   "to": null,
   "from_pt": [
    0.0,
    1720.0
   ],
   "to_pt": [
    0.0,
    1720.0
   ]
  },
  {
   "id": 26,
   "name": "PoleAccel",
   "kind": "Aux",
   "equation": "(g*SIN(PoleTh) - COS(PoleTh)*Tmp)/(l*(4/3 - m*COS(PoleTh)*COS(PoleTh)/(M+m))) - c*PoleW",
   "units": "",
   "comment": "",
   "pos": [
    300.0,
    1790.0
   ],
   "non_negative": false,
   "from": null,
   "to": null,
   "from_pt": [
    0.0,
    1790.0
   ],
   "to_pt": [
    0.0,
    1790.0
   ]
  },
  {
   "id": 27,
   "name": "CartAccel",
   "kind": "Aux",
   "equation": "Tmp - m*l*PoleAccel*COS(PoleTh)/(M+m)",
   "units": "",
   "comment": "",
   "pos": [
    300.0,
    1860.0
   ],
   "non_negative": false,
   "from": null,
