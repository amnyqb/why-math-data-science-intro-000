      "id": 9,
      "name": "Recovery Rate",
      "kind": "Flow",
      "equation": "Infectious Population I/Average Duration of Illness d",
      "units": "People/Day",
      "comment": "The rate at which the infected population recover and become immune to the    infection.",
      "pos": [
        550.0,
        190.0
      ],
