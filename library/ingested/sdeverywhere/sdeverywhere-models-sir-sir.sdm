      "lever_scale": 1.0
    },
    {
      "id": 5,
      "name": "Total Population P",
      "kind": "Constant",
      "equation": "10000",
      "units": "People",
      "comment": "The total population is constant",
      "pos": [
        257.0,
        325.0
      ],
      "table": [],
      "slider": null,
      "non_negative": false,
      "from": null,
      "to": null,
      "from_pt": [
