      "kind": "Stock",
      "equation": "0",
      "units": "People",
      "comment": "The recovered population R accumulates the recovery rate",
      "pos": [
        672.0,
        190.0
      ],
      "table": [],
      "slider": null,
      "non_negative": false,
      "from": null,
