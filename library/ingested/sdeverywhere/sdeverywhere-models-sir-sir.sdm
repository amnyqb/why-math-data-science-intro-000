      "lever_scale": 1.0
    },
    {
      "id": 11,
      "name": "Susceptible Population S",
      "kind": "Stock",
      "equation": "Total Population P - Infectious Population I -  Recovered Population R",
      "units": "People",
      "comment": "The susceptible population, as in the simple logistic epidemic model, is    reduced by the infection rate.  The initial susceptible population is the    total population less the initial number of infectives and any initially    recovered individuals.",
      "pos": [
        162.0,
        192.0
      ],
