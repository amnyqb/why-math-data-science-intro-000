    },
    {
      "id": 10,
      "name": "Infectivity i",
      "kind": "Constant",
      "equation": "0.25",
      "units": "Dimensionless",
      "comment": "The infectivity (i) of the disease is the probability that a person will    become infected after exposure to someone with the disease.",
      "pos": [
