    {
      "id": 3,
      "name": "Contact Rate c",
      "kind": "Aux",
      "equation": "Initial Contact Rate",
      "units": "1/Day",
      "comment": "People in the community interact at a certain rate (the Contact Rate, c,    measured in people contacted per person per time period, or 1/time    periods).  The contact rate rises at the Ramp Slope starting in day 1.",
      "pos": [
        168.0,
        300.0
      ],
      "table": [],
      "slider": null,
      "non_negative": false,
      "from": null,
      "to": null,
      "from_pt": [
        -80.0,
        0.0
      ],
      "to_pt": [
        80.0,
        0.0
      ],
      "view": 0,
      "set": null,
      "by_item": [],
      "rollup": "Total",
      "lever": false,
      "lever_scale": 1.0
    },
    {
      "id": 4,
      "name": "Reproduction Rate",
      "kind": "Aux",
      "equation": "Contact Rate c*Infectivity i*Average Duration of Illness d*Susceptible Population S/   Total Population P",
      "units": "Dimensionless",
      "comment": "",
      "pos": [
        383.0,
        472.0
      ],
      "table": [],
      "slider": null,
      "non_negative": false,
