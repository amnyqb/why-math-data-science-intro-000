    {
      "id": 19,
      "name": "total supply available",
      "kind": "Aux",
      "equation": "IF THEN ELSE(integer supply, FLOOR(Initial Supply + (Final Supply - Initial Supply) * (TIME - INITIAL TIME) / (FINAL TIME - INITIAL TIME)), Initial Supply + (Final Supply - Initial Supply) * (TIME - INITIAL TIME) / (FINAL TIME - INITIAL TIME))",
      "units": "Widget/Month",
      "comment": "Test input for total supply - creates a ramp over time.",
      "pos": [
        522.0,
        271.0
      ],
      "table": [],
      "slider": null,
      "non_negative": false,
      "from": null,
      "to": null,
