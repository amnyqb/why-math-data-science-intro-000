  "purpose": {
    "problem": "Why does a fishery open to everyone end up with a small stock and a big idle fleet, and which rule keeps both the fish and the profit?",
    "kind": "design a policy",
    "out_of_scope": "several species, fish age classes, price changes, fuel and crew markets",
    "objectives": [
      {
        "title": "Keep the stock healthy",
        "kind": "stay within a band",
        "test": "Fish stays above half of Carrying Capacity (500 tonne) at the end of the 100 years.",
        "var": "Fish"
      },
      {
        "title": "Keep the fleet profitable",
        "kind": "grow to a plateau",
        "test": "Profit settles at a positive level instead of falling to zero.",
        "var": "Profit"
      }
    ]
  }
}