  "purpose": {
    "problem": "How big does one outbreak get, when does it peak, and how far must contacts fall to stop it?",
    "kind": "understand behaviour",
    "out_of_scope": "births, deaths, waning immunity, vaccination, spatial spread",
    "objectives": [
      {
        "title": "Keep the peak small",
        "kind": "stay within a band",
        "test": "Infectious stays below 50000 people at every day.",
        "var": "Infectious"
      }
    ]
  }
