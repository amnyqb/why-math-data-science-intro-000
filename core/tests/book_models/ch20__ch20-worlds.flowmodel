      "rollup": "Total",
      "lever": false,
      "lever_scale": 1.0
    },
    {
      "id": 10,
      "name": "Effect of Delay on Demand",
      "kind": "Aux",
      "equation": "EXP(-Volatile Demand * Customer Impatience * MAX(0, Perceived Delivery Delay / Target Delivery Time - 1))",
      "units": "dmnl",
      "comment": "Share of would-be orders that stay when delivery is slower than normal.",
      "pos": [
        880.0,
        250.0
      ],
      "table": [],
      "slider": null,
