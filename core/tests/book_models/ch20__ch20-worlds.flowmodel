    {
      "id": 9,
      "name": "Perceived Delivery Delay",
      "kind": "Aux",
      "equation": "SMOOTHI(Backlog / MAX(Shipments, 1), 1, Target Delivery Time)",
      "units": "week",
      "comment": "Delivery delay as customers experience it.",
      "pos": [
        690.0,
        250.0
      ],
      "table": [],
      "slider": null,
      "non_negative": false,
      "from": null,
      "to": null,
