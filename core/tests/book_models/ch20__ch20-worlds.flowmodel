    {
      "id": 3,
      "name": "Demand Pattern",
      "kind": "Flow",
      "equation": "Base Demand * (1 + STEP(Demand Jump, 10) - Volatile Demand * STEP(Demand Reversal, 30) + Volatile Demand * Season Amplitude * SIN(6.28319 * Time / Season Period))",
      "units": "case/week",
      "comment": "Orders customers would place if delivery were normal: a step, or (volatile world) a surge, a reversal and a season.",
      "pos": [
        190.0,
        380.0
      ],
      "table": [],
      "slider": null,
      "non_negative": false,
      "from": null,
      "to": 12,
      "from_pt": [
        90.0,
        380.0
      ],
      "to_pt": [
        80.0,
        0.0
      ],
      "view": 0,
      "set": null,
      "by_item": [],
      "rollup": "Total",
      "lever": false,
      "lever_scale": 1.0
    },
    {
