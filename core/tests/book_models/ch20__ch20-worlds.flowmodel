    {
      "id": 40,
      "name": "Supplier Capacity",
      "kind": "Aux",
      "equation": "Fragile Supply * Normal Supplier Capacity * (1 - Outage Depth * PULSE(Outage Start, Outage Duration)) + (1 - Fragile Supply) * Unlimited Capacity",
      "units": "case/week",
      "comment": "Shipping capacity of the supplier (effectively unlimited when supply is dependable).",
