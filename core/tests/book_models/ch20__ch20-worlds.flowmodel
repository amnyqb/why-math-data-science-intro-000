    {
      "id": 27,
      "name": "Believed Supply Delay",
      "kind": "Aux",
      "equation": "Lead Time Measured * MIN(Measured Supply Delay, Delay Cap) + (1 - Lead Time Measured) * Quoted Lead Time",
