      "kind": "Constant",
      "equation": "1",
      "units": "dmnl",
      "comment": "Policy switch: 1 uses the measured actual delay, 0 uses the quoted lead time.",
      "pos": [
        120.0,
        770.0
      ],
      "table": [],
      "slider": null,
      "non_negative": false,
