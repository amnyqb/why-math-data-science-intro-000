      "id": 29,
      "name": "Goal Anchoring",
      "kind": "Constant",
      "equation": "0",
      "units": "dmnl",
      "comment": "0: the standard drifts to the time actually spent; 1: the standard is held at the required time.",
      "pos": [
        690.0,
