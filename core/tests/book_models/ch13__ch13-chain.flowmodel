      "kind": "Aux",
      "equation": "RANDOM NORMAL(-4, 4, 0, 1, Noise Seed)",
      "units": "dmnl",
      "comment": "Independent standard normal draw each time step.",
      "pos": [
        120.0,
        250.0
      ],
      "table": [],
      "slider": null,
