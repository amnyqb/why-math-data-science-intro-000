    {
      "id": 11,
      "name": "Orders",
      "kind": "Flow",
      "equation": "MAX(0, Expected Demand + (Desired Inventory - Inventory) / Inventory Adjustment Time)",
      "units": "cases/Week",
      "comment": "Cases ordered each week: the forecast plus a correction for the inventory gap (the rule as practised)",
      "pos": [
        115.0,
        330.0
      ],
      "table": [],
      "slider": null,
      "non_negative": false,
