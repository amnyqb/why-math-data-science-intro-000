      ],
      "view": 38,
      "set": null,
      "by_item": [],
      "rollup": "Total",
      "lever": false,
      "lever_scale": 1.0
    },
    {
      "id": 13,
      "name": "Loading Starts",
      "kind": "Flow",
      "equation": "IF THEN ELSE(Formulation = 1, MIN(Loading Capacity, Trucks Waiting / Minimum Wait),  IF THEN ELSE(Formulation = 2, Loading Capacity * (1 - EXP(-Trucks Waiting / (Loading Capacity * Queue Time Constant))),  Loading Capacity * Trucks Waiting / (Trucks Waiting + Half Queue)))",
      "units": "truck/hour",
      "comment": "Trucks leaving the line for a bay. 1: hard MIN. 2: exponential. 3: hyperbolic.",
      "pos": [
        540.0,
        300.0
      ],
      "table": [],
      "slider": null,
      "non_negative": false,
      "from": 14,
      "to": null,
      "from_pt": [
