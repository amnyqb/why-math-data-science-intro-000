    {
      "id": 12,
      "name": "Half Queue",
      "kind": "Constant",
      "equation": "0.46",
      "units": "truck",
      "comment": "Trucks waiting at which loading runs at half capacity (hyperbolic formulation).",
      "pos": [
        620.0,
        480.0
      ],
      "table": [],
      "slider": null,
      "non_negative": false,
      "from": null,
      "to": null,
      "from_pt": [
