  "manifest": {
    "title": "Contractor crews in a regional market",
    "description": "Crews grow by reinvesting margin until the region's demand limits utilisation. Used for capacity strategy, for a training game and, restarted monthly from the crew count, for one-month-ahead planning.",
    "levers": [
      {
        "name": "Crews per Project",
        "units": "crew/project",
        "min": 0.05,
        "max": 0.12,
        "default": 0.08,
        "explanation": "Margin per project reinvested in new crews",
        "group": "Policy"
      },
      {
        "name": "Base Demand",
        "units": "projects/month",
        "min": 30.0,
        "max": 70.0,
        "default": 50.0,
        "explanation": "Projects the region offers each month",
        "group": "Market"
      },
      {
        "name": "Perception Delay",
        "units": "month",
        "min": 0.25,
        "max": 12.0,
        "default": 0.25,
        "explanation": "Time for management to see utilisation",
        "group": "Policy"
      }
    ],
    "outputs": [
      {
        "variable": "Crews",
        "chart": "line",
        "units": "crew",
        "reference_lines": []
      },
      {
        "variable": "Utilisation",
        "chart": "line",
        "units": "dmnl",
        "reference_lines": []
      }
    ],
    "scenarios": [
      {
        "name": "Calibrated",
        "values": {
          "Base Demand": 49.0,
          "Crews per Project": 0.08
        }
      },
      {
        "name": "Late reading",
        "values": {
          "Perception Delay": 6.0
        }
      },
      {
        "name": "Weak region",
        "values": {
          "Base Demand": 40.0
        }
      }
    ],
    "bindings": [
      {
        "input": "Initial Crews",
        "source": "crew_counts.csv",
        "column": "crews",
        "kind": "data",
        "note": "Latest monthly count; the model is restarted from it each month"
      },
      {
        "input": "Base Demand",
        "source": "tender_forecast",
        "column": "projects",
        "kind": "forecast",
        "note": "Regional tender forecast, refreshed quarterly"
      }
    ],
    "validity": [
      {
        "statement": "Calibrated on months 0 to 30; trusted for crews between 0 and 60 over 24 months",
        "variable": "Crews",
        "min": 0.0,
        "max": 60.0,
        "horizon": 24.0
      }
    ],
    "tests": [
      "Crews never negative",
      "Utilisation is a share",
      "Crews stay within what the region can carry"
    ],
    "goals": [
      {
        "name": "Crews at month 72",
        "output": "Crews",
        "measure": "final",
        "direction": "max",
        "policies": [
          "Calibrated",
          "Late reading"
        ],
        "protected_ranking": false,
        "transform": ""
      }
    ],
    "reduced_from": ""
  }
