      "id": 6,
      "name": "Fix Sensitivity",
      "kind": "Constant",
      "equation": "5",
      "units": "dmnl",
      "comment": "Share of maintenance hours moved to production per unit of perceived shortfall fraction (0: no fix).",
      "pos": [
        610.0,
        270.0
