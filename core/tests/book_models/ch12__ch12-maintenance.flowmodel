    {
      "id": 7,
      "name": "Maintenance Hours",
      "kind": "Aux",
      "equation": "Normal Maintenance Hours * MAX(0, 1 - Fix Sensitivity * Perceived Shortfall)",
      "units": "hour/week",
      "comment": "The fix: fewer maintenance hours when output falls short.",
      "pos": [
        450.0,
        320.0
