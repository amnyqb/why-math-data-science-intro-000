 "manifest": {
  "title": "Distributor stockouts",
  "description": "Weekly inventory, ordering and shipments of one distribution centre facing two-week promotions every eight weeks. Built to explain chronic stockouts and test ordering rules.",
  "levers": [
   {
    "name": "Inventory Adjustment Time",
    "units": "Week",
    "min": 0.5,
    "max": 6.0,
    "default": 1.0,
    "explanation": "Time over which planners try to close an inventory gap",
    "group": "Ordering rule"
   },
   {
    "name": "Supply Line Weight",
    "units": "dmnl",
    "min": 0.0,
    "max": 1.0,
    "default": 0.0,
    "explanation": "Share of the supply line gap that orders correct",
    "group": "Ordering rule"
   },
   {
    "name": "Inventory Coverage",
    "units": "Week",
    "min": 0.75,
    "max": 3.0,
    "default": 1.5,
    "explanation": "Weeks of expected demand held as stock",
    "group": "Ordering rule"
   },
   {
    "name": "Forecast Time",
    "units": "Week",
    "min": 1.0,
    "max": 4.0,
    "default": 2.0,
    "explanation": "Averaging time for the demand forecast",
    "group": "Forecast"
   },
   {
    "name": "Promotion Lift",
    "units": "cases/Week",
    "min": 0.0,
    "max": 600.0,
    "default": 400.0,
    "explanation": "Extra customer orders per week during a promotion",
    "group": "Market"
   }
  ],
  "outputs": [
   {
    "variable": "Inventory",
    "chart": "line",
    "units": "cases",
    "reference_lines": []
   },
   {
    "variable": "Fill Rate",
    "chart": "line",
    "units": "dmnl",
    "reference_lines": []
   },
   {
    "variable": "Orders",
    "chart": "line",
    "units": "cases/Week",
    "reference_lines": []
   }
  ],
  "scenarios": [
   {
    "name": "As practised",
    "values": {
     "Inventory Adjustment Time": 1.0,
     "Supply Line Weight": 0.0
    }
   },
   {
    "name": "Count the pipeline",
    "values": {
     "Inventory Adjustment Time": 1.0,
     "Supply Line Weight": 1.0
    }
   },
   {
    "name": "Correct slowly",
    "values": {
