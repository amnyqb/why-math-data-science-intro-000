     "Supply Line Weight": 0.0
    }
   },
   {
    "name": "Count the pipeline, correct over 2 weeks",
    "values": {
     "Inventory Adjustment Time": 2.0,
     "Supply Line Weight": 1.0
    }
   },
   {
    "name": "No promotions",
    "values": {
     "Promotion Lift": 0.0
    }
   }
  ],
  "bindings": [],
