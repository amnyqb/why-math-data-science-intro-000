    {
      "id": 15,
      "name": "Priority Share",
      "kind": "Aux",
      "equation": "ALLOCATE BY PRIORITY ITEM(0, 3, Orders[North], Orders[South], Orders[East], Priority[North], Priority[South], Priority[East], 0.5, Supply)",
      "units": "kL/day",
      "comment": "",
      "pos": [
        690.0,
        380.0
      ],
      "table": [],
      "slider": null,
      "non_negative": false,
