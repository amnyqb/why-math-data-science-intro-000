        {
          "item": "South",
          "equation": "ALLOCATE BY PRIORITY ITEM(1, 3, Orders[North], Orders[South], Orders[East], Priority[North], Priority[South], Priority[East], 0.5, Supply)",
          "table": []
        },
        {
          "item": "East",
          "equation": "ALLOCATE BY PRIORITY ITEM(2, 3, Orders[North], Orders[South], Orders[East], Priority[North], Priority[South], Priority[East], 0.5, Supply)",
          "table": []
        }
      ],
      "rollup": "Total",
      "lever": false,
      "lever_scale": 1.0
    },
