    {
      "id": 6,
      "name": "White Noise",
      "kind": "Aux",
      "equation": "Noise Level * SQRT(2 * Noise Correlation Time / TIME STEP) * RANDOM NORMAL(-6, 6, 0, 1, Noise Seed)",
      "units": "units/week",
      "comment": "Independent draws each time step, scaled so the smoothed noise has standard deviation Noise Level.",
      "pos": [
        120.0,
        250.0
      ],
      "table": [],
      "slider": null,
      "non_negative": false,
      "from": null,
      "to": null,
