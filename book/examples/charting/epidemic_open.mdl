{UTF-8}

Susceptible = INTEG(births + waning - infection - natural death S, 9990)
	~	Person
	~	|

Exposed = INTEG(infection - onset - natural death E, 10)
	~	Person
	~	|

Infectious = INTEG(onset - recovery - disease deaths - natural death I, 0)
	~	Person
	~	|

Recovered = INTEG(recovery - waning - natural death R, 0)
	~	Person
	~	|

births = total population * birth rate
	~	Person/day
	~	|

infection = contact rate * Susceptible * Infectious / total population
	~	Person/day
	~	|

onset = Exposed / incubation time
	~	Person/day
	~	|

recovery = Infectious / infectious time
	~	Person/day
	~	|

disease deaths = Infectious * disease death rate
	~	Person/day
	~	|

waning = Recovered / immunity time
	~	Person/day
	~	|

natural death S = Susceptible * natural death rate
	~	Person/day
	~	|

natural death E = Exposed * natural death rate
	~	Person/day
	~	|

natural death I = Infectious * natural death rate
	~	Person/day
	~	|

natural death R = Recovered * natural death rate
	~	Person/day
	~	|

total population = Susceptible + Exposed + Infectious + Recovered
	~	Person
	~	|

contact rate = 0.45
	~	1/day
	~	|

incubation time = 4
	~	day
	~	|

infectious time = 7
	~	day
	~	|

immunity time = 120
	~	day
	~	|

disease death rate = 0.002
	~	1/day
	~	|

birth rate = 0.0004
	~	1/day
	~	|

natural death rate = 0.0004
	~	1/day
	~	|

FINAL TIME = 730
	~	day
	~	|

