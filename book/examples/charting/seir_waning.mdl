{UTF-8}

Susceptible = INTEG(waning - infection, 9990)
	~	Person
	~	|

Exposed = INTEG(infection - onset, 10)
	~	Person
	~	|

Infectious = INTEG(onset - recovery, 0)
	~	Person
	~	|

Recovered = INTEG(recovery - waning, 0)
	~	Person
	~	|

infection = contact rate * Susceptible * Infectious / total population
	~	Person/day
	~	|

onset = Exposed / incubation time
	~	Person/day
	~	|

recovery = Infectious / infectious time
	~	Person/day
	~	|

waning = Recovered / immunity time
	~	Person/day
	~	|

total population = Susceptible + Exposed + Infectious + Recovered
	~	Person
	~	|

contact rate = 0.45
	~	1/day
	~	|

incubation time = 4
	~	day
	~	|

infectious time = 7
	~	day
	~	|

immunity time = 120
	~	day
	~	|

FINAL TIME = 400
	~	day
	~	|

INITIAL TIME = 0
	~	day
	~	|

TIME STEP = 0.125
	~	day
	~	|

SAVEPER = 1
	~	day
	~	|

