    {
      "id": 11,
      "name": "Real WACC",
      "kind": "Aux",
      "equation": "REAL RATE(WACC(Debt Share, Cost of Debt, Cost of Equity), Inflation)",
      "units": "dmnl",
      "comment": "Real weighted average cost of capital: the nominal WACC deflated by inflation",
      "pos": [
        340.0,
        100.0
      ],
      "table": [],
      "slider": null,
      "non_negative": false,
      "from": null,
      "to": null,
      "from_pt": [
        260.0,
        100.0
      ],
      "to_pt": [
        420.0,
        100.0
      ],
      "view": 25,
      "set": null,
      "by_item": [],
      "rollup": "Total",
      "lever": false,
      "lever_scale": 1.0
    },
    {
      "id": 16,
      "name": "Output",
      "kind": "Aux",
      "equation": "Yield * (1 - Degradation)^(Time / Year Length)",
      "units": "kWh/(kWp*Year)",
      "comment": "Energy produced in the year, after degradation",
      "pos": [
        340.0,
        190.0
      ],
      "table": [],
      "slider": null,
      "non_negative": false,
      "from": null,
      "to": null,
      "from_pt": [
        260.0,
        190.0
      ],
      "to_pt": [
        420.0,
        190.0
      ],
      "view": 25,
      "set": null,
      "by_item": [],
      "rollup": "Total",
      "lever": false,
      "lever_scale": 1.0
    },
    {
      "id": 19,
      "name": "LCOE",
      "kind": "Aux",
      "equation": "LEVELISED(OM, Output, Real WACC, Capex) * kWh per MWh",
      "units": "EUR/MWh",
      "comment": "Levelised cost of energy: discounted costs over discounted energy",
      "pos": [
        340.0,
        280.0
      ],
      "table": [],
      "slider": null,
      "non_negative": false,
      "from": null,
